<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MaksIT.UScheduler.UI.ViewModels"
             xmlns:controls="using:MaksIT.UScheduler.UI.Controls"
             xmlns:local="using:MaksIT.UScheduler.UI"
             x:Class="MaksIT.UScheduler.UI.Views.SettingsView"
             x:DataType="vm:MainViewModel">
  <UserControl.Resources>
    <local:NamedColorBrushConverter x:Key="NamedColorBrush" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8">
      <controls:GroupBox Header="Service">
        <Grid RowDefinitions="Auto,Auto">
          <TextBlock Text="{Binding AppSettingsLoadError}"
                     IsVisible="{Binding HasAppSettingsLoadError}"
                     Classes="warning"
                     TextWrapping="Wrap"
                     Margin="0,0,0,8" />

          <StackPanel Grid.Row="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">
            <TextBlock Text="Name:"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding ServiceName}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBlock Text="Status:"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <Ellipse Width="12"
                     Height="12"
                     VerticalAlignment="Center"
                     Fill="{Binding ServiceStatusColor, Converter={StaticResource NamedColorBrush}}" />
            <TextBlock Text="{Binding ServiceStatusText}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <Button Content="Reload"
                    Command="{Binding ReloadAppSettingsCommand}"
                    MinWidth="70"
                    VerticalAlignment="Center"
                    Margin="0" />
          </StackPanel>
        </Grid>
      </controls:GroupBox>

      <TextBlock Text="The window runs without elevation. Register, start, stop, and unregister prompt for administrator approval in place."
                 Classes="hint"
                 TextWrapping="Wrap"
                 Margin="0,0,0,8" />

      <controls:GroupBox Header="Locations">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
          <TextBlock Text="Settings file:"
                     VerticalAlignment="Center"
                     Margin="0,0,10,8"
                     FontWeight="Bold" />
          <TextBox Grid.Column="1"
                   Text="{Binding SharedSettingsPath}"
                   Margin="0,0,0,8"
                   IsReadOnly="True" />
          <TextBlock Grid.Row="1"
                     Text="Scripts:"
                     VerticalAlignment="Center"
                     Margin="0,0,10,8"
                     FontWeight="Bold" />
          <TextBox Grid.Row="1"
                   Grid.Column="1"
                   Text="{Binding ScriptsDirectory}"
                   Margin="0,0,0,8"
                   IsReadOnly="True" />
          <TextBlock Grid.Row="2"
                     Text="Log directory:"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"
                     FontWeight="Bold" />
          <TextBox Grid.Row="2"
                   Grid.Column="1"
                   Text="{Binding LogDirectory}"
                   IsReadOnly="True" />
        </Grid>
      </controls:GroupBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>
