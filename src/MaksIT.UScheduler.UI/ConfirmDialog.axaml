<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:footer="using:MaksIT.UScheduler.UI.Controls.Footer"
        x:Class="MaksIT.UScheduler.UI.ConfirmDialog"
        Title="Confirm"
        Icon="/Assets/icon.ico"
        Width="440"
        Height="180"
        MinWidth="360"
        MinHeight="160"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
  <DockPanel Margin="16">
    <footer:WindowFooter x:Name="Actions"
                         DockPanel.Dock="Bottom"
                         Margin="0,16,0,0"
                         Spacing="8" />
    <TextBlock Name="MessageText"
               TextWrapping="Wrap"
               VerticalAlignment="Center" />
  </DockPanel>
</Window>
