<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:footer="using:MaksIT.UScheduler.UI.Controls.Footer"
        xmlns:vm="using:MaksIT.UScheduler.UI.ViewModels"
        xmlns:shared="using:MaksIT.UScheduler.Shared"
        x:Class="MaksIT.UScheduler.UI.Windows.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/icon.ico"
        Title="{x:Static shared:AppInfo.AboutTitle}">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="{Binding Brand}" Classes="hint" Margin="0" />
    <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Summary}" Classes="hint" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
          Margin="0,8,0,0">
      <TextBlock Text="Version" Classes="hint" />
      <TextBlock Grid.Column="1" Text="{Binding Version}" FontWeight="SemiBold" />

      <TextBlock Grid.Row="1" Text="Credits" Classes="hint" Margin="0,8,0,0" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Credits}" Margin="0,8,0,0" />

      <TextBlock Grid.Row="2" Text="{Binding SecurityContact.Role}" Classes="hint" Margin="0,8,0,0" />
      <Button Grid.Row="2" Grid.Column="1" Content="{Binding SecurityContact.Address}"
              Command="{Binding OpenContactCommand}" CommandParameter="{Binding SecurityContact.Uri}"
              HorizontalAlignment="Left" Padding="8,4" Margin="0,6,0,0" />

      <TextBlock Grid.Row="3" Text="{Binding SupportContact.Role}" Classes="hint" Margin="0,8,0,0" />
      <Button Grid.Row="3" Grid.Column="1" Content="{Binding SupportContact.Address}"
              Command="{Binding OpenContactCommand}" CommandParameter="{Binding SupportContact.Uri}"
              HorizontalAlignment="Left" Padding="8,4" Margin="0,6,0,0" />

      <TextBlock Grid.Row="4" Text="License" Classes="hint" Margin="0,8,0,0" />
      <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding License}" Margin="0,8,0,0" />

      <TextBlock Grid.Row="5" Text="Copyright" Classes="hint" Margin="0,8,0,0" />
      <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Copyright}" Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>

    <footer:WindowFooter x:Name="Actions" Margin="0,12,0,0" Spacing="8" />
  </StackPanel>
</Window>
