<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:footer="using:MaksIT.UScheduler.UI.Controls.Footer"
        xmlns:vm="using:MaksIT.UScheduler.UI.ViewModels"
        x:Class="MaksIT.UScheduler.UI.Windows.ErrorWindow"
        x:DataType="vm:ErrorReportViewModel"
        Width="720"
        Height="520"
        MinWidth="480"
        MinHeight="360"
        CanResize="True"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.ico"
        Title="UScheduler">
  <DockPanel Margin="16">
    <footer:WindowFooter x:Name="Actions"
                         DockPanel.Dock="Bottom"
                         Margin="0,12,0,0"
                         Spacing="8" />
    <TextBlock DockPanel.Dock="Top"
               Text="Something went wrong. The details below are also saved under Help → Logs."
               Classes="hint"
               TextWrapping="Wrap"
               Margin="0,0,0,12" />
    <TextBox Text="{Binding Report}"
             Classes="error-dump"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
